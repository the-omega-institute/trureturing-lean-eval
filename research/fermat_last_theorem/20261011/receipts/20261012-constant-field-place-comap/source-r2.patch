-      obtain ⟨k, d, w'', hd, heq⟩ := ih (w.mapRange rest hrest0) j₁ hw' hord
-      refine ⟨k + 1, d, w'', hd, ?_⟩
-      rw [step w, hd0, map_zero, zero_add, heq]
-      ring
