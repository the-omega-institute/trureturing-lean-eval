ValuationSubring.exists_mem_inertiaSubgroupIn_apply_eq_pow_of_pow_eight_eq_one : ∀
  (A : ValuationSubring (AlgebraicClosure ℚ)),
  A.LiesOverPrime 2 →
    ∀ (u : (ZMod 8)ˣ),
      ∃ σ ∈ ValuationSubring.inertiaSubgroupIn ℚ A, ∀ (μ : AlgebraicClosure ℚ), μ ^ 8 = 1 → σ μ = μ ^ (↑u).val
solution : ∀ (q : ℕ),
  Nat.Prime q →
    ∀ (m : ℕ),
      Odd q ∧ m = q ∨ q = 2 ∧ m = 8 →
        ∀ (cyc : Gal(AlgebraicClosure ℚ/ℚ) →* (ZMod m)ˣ),
          (∀ (σ : Gal(AlgebraicClosure ℚ/ℚ)) (μ : AlgebraicClosure ℚ), μ ^ m = 1 → σ μ = μ ^ (↑(cyc σ)).val) →
            ∀ {K : Type} [inst : Field K] (χ : (ZMod m)ˣ →* Kˣ),
              χ ≠ 1 →
                ∀ (A : ValuationSubring (AlgebraicClosure ℚ)),
                  A.LiesOverPrime q → ∃ σ ∈ ValuationSubring.inertiaSubgroupIn ℚ A, χ (cyc σ) ≠ 1
solution_corollary_neg_one : ∀ (q : ℕ),
  Nat.Prime q →
    ∀ (m : ℕ),
      Odd q ∧ m = q ∨ q = 2 ∧ m = 8 →
        ∀ (cyc : Gal(AlgebraicClosure ℚ/ℚ) →* (ZMod m)ˣ),
          (∀ (σ : Gal(AlgebraicClosure ℚ/ℚ)) (μ : AlgebraicClosure ℚ), μ ^ m = 1 → σ μ = μ ^ (↑(cyc σ)).val) →
            ∀ {K : Type} [inst : Field K] (χ : (ZMod m)ˣ →* Kˣ),
              (∀ (u : (ZMod m)ˣ), χ u * χ u = 1) →
                χ ≠ 1 →
                  ∀ (A : ValuationSubring (AlgebraicClosure ℚ)),
                    A.LiesOverPrime q → ∃ σ ∈ ValuationSubring.inertiaSubgroupIn ℚ A, χ (cyc σ) = -1
