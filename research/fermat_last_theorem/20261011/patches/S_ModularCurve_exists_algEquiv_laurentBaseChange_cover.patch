+private theorem exists_recastAlgEquiv {K A : Type*} [CommSemiring K]
+    (s t : Semiring A) (a : @Algebra K A _ s) (b : @Algebra K A _ t)
+    (hadd : (letI := s; HAdd.hAdd : A → A → A) =
+      (letI := t; HAdd.hAdd : A → A → A))
+    (hmul : (letI := s; HMul.hMul : A → A → A) =
+      (letI := t; HMul.hMul : A → A → A))
+    (hmap : ∀ r : K, a.algebraMap r = b.algebraMap r)
+    (f : @AlgEquiv K A A _ s s a a) :
+    ∃ g : @AlgEquiv K A A _ t t b b, ∀ x : A, g x = f x := by
+  have hsemiring : s = t := Semiring.ext hadd hmul
+  subst t
+  have halgebra : a = b := Algebra.algebra_ext a b hmap
+  subst b
+  exact ⟨f, fun _ => rfl⟩
+
+private theorem exists_cover_for_instances
+    (K : Type*) {E F : Type*} [Field K] [Field E] [Algebra K E]
