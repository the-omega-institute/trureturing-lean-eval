+    (M : IntermediateField K E) (hM : M = IntermediateField.adjoin K (Set.range φ))
+    (s : Semiring M) (a : @Algebra K M _ s)
+    (hadd : (letI := (SubsemiringClass.toCommSemiring M).toSemiring;
+        HAdd.hAdd : M → M → M) = (letI := s; HAdd.hAdd : M → M → M))
+    (hmul : (letI := (SubsemiringClass.toCommSemiring M).toSemiring;
+        HMul.hMul : M → M → M) = (letI := s; HMul.hMul : M → M → M))
+    (hmap : ∀ r : K,
+      (IntermediateField.algebra' (R' := K) M).algebraMap r = a.algebraMap r)
+    (ψ : F → E) (hψ : ∀ y : F, ψ y ∈ M) (hφ : ∀ y : F, φ y = ψ y) :
+    ∃ τ : @AlgEquiv K M M _ s s a a,
+      ∀ y : F, ((τ ⟨ψ y, hψ y⟩ : M) : E) = ψ (σ y) := by
+  obtain ⟨τ, hτ⟩ := exists_cover K φ hLD σ M hM
+  obtain ⟨τ', hτ'⟩ := exists_recastAlgEquiv
+    (SubsemiringClass.toCommSemiring M).toSemiring s
+    (IntermediateField.algebra' (R' := K) M) a hadd hmul hmap τ
+  refine ⟨τ', fun y => ?_⟩
+  have hx : (⟨φ y, hM ▸ IntermediateField.subset_adjoin K _ ⟨y, rfl⟩⟩ : M) =
+      ⟨ψ y, hψ y⟩ := Subtype.ext (hφ y)
+  calc
+    ((τ' ⟨ψ y, hψ y⟩ : M) : E)
+        = ((τ ⟨ψ y, hψ y⟩ : M) : E) := congrArg Subtype.val (hτ' _)
+    _ = φ (σ y) := by rw [← hx]; exact hτ y
+    _ = ψ (σ y) := hφ _
 
